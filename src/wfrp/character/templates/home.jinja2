{% extends "layout.jinja2" %}

{% block content %}
    <h1>Home</h1>
    <div>
        <a href="/build/new">Add new character</a>
    </div>
    {% if active_characters %}
        <h2>Active Characters</h2>
        <ul>
            {% for character in active_characters %}
                <div>
                    <a href={{ url_for('character_view' , id=character.id) }}>
                        {{ character.get_display_title() }}
                    </a>
                </div>
            {% endfor %}
        </ul>
    {% endif %}
    {% if build_characters %}
        <h2>Building Characters</h2>
        <ul>
            {% for character in build_characters %}
                <div>
                    <a href={{ url_for('character_view' , id=character.id) }}>
                        {{ character.get_display_title() }}
                    </a>
                </div>
            {% endfor %}
        </ul>
    {% endif %}
{% endblock %}
