{% extends "build/build_layout.jinja2" %}

{% block build_content %}
    <h1>Species and Career Skills</h1>
    <form action="" method="post">
        {{ form.hidden_tag() }}
        {% set errors = form.form_errors %}
        {% include "includes/form_error.jinja2" %}
        <p>
            A Skill’s starting value is equal to its associated Characteristic.
            Each Advance increases a Skill by +5.
        </p>
        <p>
            Add one Advance (+5) to any five of the following Skills:
        </p>
        {% set errors = form.species_skills.species_skills.errors %}
        {% include "includes/form_error.jinja2" %}
        <div {{ "class=is-invalid" if form.species_skills.species_skills.errors}}>
            {% for field in form.get_fields("species_skills") %}
                <p>
                    {{ field.label }}<br>
                    {{ field }}
                </p>
            {% endfor %}
        </div>
        <p>
            Assign 8 Advances among your Career Skills.
        </p>
        <p>
            You may assign more than one Advance to the same Skill,
            but no Skill can receive more than 3 Advances (+15) during
            Character Creation.
            {{ form.career_skills.errors["errors"] }}
        </p>
        {% set errors = form.career_skills.form_errors %}
        {% include "includes/form_error.jinja2" %}
        <div {{ "class=is-invalid" if form.career_skills.form_errors}}>
            {% for field in form.get_fields("career_skills") %}
                <p>
                    {{ field.label }}<br>
                    {{ field }}
                </p>
            {% endfor %}
        </div>
        <p>{{ form.submit() }}</p>
    </form>
{% endblock %}
