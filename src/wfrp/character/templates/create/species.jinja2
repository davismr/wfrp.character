{% extends "create/create_layout.jinja2" %}

{% block create_content %}
    <h1>Species</h1>
    <p>
        You rolled a {{ character.create_data["die_roll"] }} which is a
        {{ character.create_data["species"] }}.
    </p>
    <p>
        You can gain an extra point of Fortune if
        you accept this, or select a different species.
    </p>
    <form action="" method="post">
        {{ form.hidden_tag() }}
        <p>
            {{ form.species.label }}<br>
            {{ form.species }}
        </p>
        <p>{{ form.submit() }}</p>
    </form>
{% endblock %}
