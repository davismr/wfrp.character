{% extends "create/create_layout.jinja2" %}

{% block create_content %}
    <h1>Trappings</h1>
    <form action="" method="post">
        {{ form.hidden_tag() }}
        <h3>Class Trappings</h3>
        <div>
            {% for field in form.get_fields("class_trappings") %}
                <p>
                    {{ field.label }}<br>
                    {{ field }}
                </p>
            {% endfor %}
        </div>
        <h3>Career Trappings</h3>
        <div>
            {% for field in form.get_fields("career_trappings") %}
                <p>
                    {{ field.label }}<br>
                    {{ field }}
                </p>
            {% endfor %}
        </div>
        <p>{{ form.submit() }}</p>
    </form>
{% endblock %}
