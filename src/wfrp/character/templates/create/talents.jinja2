{% extends "create/create_layout.jinja2" %}

{% block create_content %}
    <h1>Species and Career Talents</h1>
    <form action="" method="post">
        {{ form.hidden_tag() }}
        <p>Choose your Species Talents.</p>
        {% for field in form.get_fields("species_talents") %}
            <p>
                {{ field.label }}<br>
                {{ field }}
            </p>
        {% endfor %}
        <p>Choose a Talent from the first level of your Career.</p>
        {% for field in form.get_fields("career_talents") %}
            <p>
                {{ field.label }}<br>
                {{ field }}
            </p>
        {% endfor %}
        <p>{{ form.submit() }}</p>
    </form>
{% endblock %}
